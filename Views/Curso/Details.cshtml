@model Academico.Models.Curso
@{
    ViewData["Title"] = "Detalhes do Curso";
}

<h1>Detalhes</h1>
<h4>Curso</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nome)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CargaHoraria)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.CargaHoraria)</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Departamento)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Departamento!.Nome)</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>

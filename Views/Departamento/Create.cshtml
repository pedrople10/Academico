@model Academico.Models.Departamento
@{
    ViewData["Title"] = "Novo Departamento";
}

<h1>Novo Departamento</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-2">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="InstituicaoId" class="control-label"></label>
                <select asp-for="InstituicaoId" class="form-select" asp-items="ViewBag.InstituicaoId">
                    <option value="">-- Selecione --</option>
                </select>
                <span asp-validation-for="InstituicaoId" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Salvar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

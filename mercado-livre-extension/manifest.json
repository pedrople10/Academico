{
  "manifest_version": 3,
  "name": "Anúncios ML por Imagem",
  "description": "Envie fotos de um produto e a extensão gera e publica o anúncio no Mercado Livre automaticamente usando IA.",
  "version": "1.0.0",
  "default_locale": "pt_BR",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "identity", "tabs"],
  "host_permissions": [
    "https://api.mercadolibre.com/*",
    "https://api.mercadolivre.com/*",
    "https://auth.mercadolivre.com.br/*",
    "https://auth.mercadolibre.com.ar/*",
    "https://api.anthropic.com/*"
  ]
}
